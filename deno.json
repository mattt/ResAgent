{
  "unstable": ["raw-imports"],
  "tasks": {
    "env-ai": "deno run --allow-ffi --allow-env --allow-read --allow-write --allow-net --unstable-ffi src/ai/main.ts",
    "pull": "deno run --allow-net --allow-read --allow-write --allow-env --allow-sys src/hub/pull.ts",
    "translate": "deno run --allow-read --allow-env src/manifest/translate.ts",
    "validate": "deno run --allow-read --allow-env src/manifest/validate.ts",
    "conformance": "deno run --allow-read --allow-env src/conformance/run.ts",
    "oracle": "deno run --allow-read --allow-write --allow-env --allow-run --allow-net --allow-sys src/conformance/run.ts workerd",
    "conformance:celld": "deno run --allow-read --allow-write --allow-env --allow-run --allow-net --allow-sys src/conformance/run.ts celld",
    "probe:alarm": "deno run --allow-read --allow-write --allow-env --allow-run --allow-net --allow-sys src/conformance/alarm_probe.ts",
    "gate:translate": "deno run --allow-read --allow-env src/gate/translate.ts",
    "gate:validate": "deno run --allow-read --allow-write --allow-env --allow-run --allow-sys src/gate/validate.ts",
    "gate:reference": "deno run --allow-read --allow-env src/gate/run.ts reference",
    "gate:clawpatrol": "deno run --allow-read --allow-write --allow-env --allow-run --allow-sys src/gate/run.ts clawpatrol",
    "gate:demo": "deno run --allow-read --allow-env --allow-run src/gate/demo.ts",
    "lint:objects": "deno run --allow-read src/lint/object_lint.ts",
    "shell": "deno desktop --hmr --allow-net --allow-read --allow-write --allow-env src/shell/main.ts",
    "shell:build": "deno desktop --allow-net --allow-read --allow-write --allow-env --output ResAgent.app src/shell/main.ts",
    "daemon": "deno run --allow-read --allow-write --allow-net --allow-env src/daemon/main.ts",
    "daemon:celld": "RESAGENT_ENGINE=celld deno run --allow-read --allow-write --allow-net --allow-env --allow-run --allow-sys src/daemon/main.ts",
    "test": "deno test --allow-read --allow-write --allow-net --allow-env src/",
    "test:keychain": "deno test --allow-run --allow-read --allow-env src/gate/keychain_test.ts",
    "check": "deno check src/ai/main.ts src/ai/backend.ts src/hub/pull.ts src/manifest/translate.ts src/manifest/validate.ts src/conformance/run.ts src/conformance/alarm_probe.ts src/conformance/op_executor.ts src/lint/object_lint.ts src/protocol/codec.ts src/protocol/server.ts src/protocol/memory_backend.ts src/protocol/client.ts src/shell/main.ts src/daemon/main.ts src/daemon/celld_backend.ts src/daemon/registry.ts src/gate/run.ts src/gate/translate.ts src/gate/validate.ts src/gate/demo.ts src/gate/inspector.ts src/gate/log.ts examples/research-agent/index.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@deno-mlx/models": "https://raw.githubusercontent.com/mattt/deno-mlx/main/packages/models/mod.ts",
    "@deno-mlx/core": "https://raw.githubusercontent.com/mattt/deno-mlx/main/packages/core/mod.ts",
    "@deno-mlx/tensor": "https://raw.githubusercontent.com/mattt/deno-mlx/main/packages/tensor/mod.ts",
    "@huggingface/hub": "npm:@huggingface/hub@^2.14.0",
    "@huggingface/transformers": "npm:@huggingface/transformers@^3",
    "@cdktf/hcl2json": "npm:@cdktf/hcl2json@^0.21.0",
    "@std/toml": "jsr:@std/toml@^1",
    "workerd": "npm:workerd@1.20260804.1"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 90,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  }
}
